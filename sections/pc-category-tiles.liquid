{%- comment -%}
  Pawfectionco category tiles: "Start where the mess is" — a row of collection
  cards (image, title, one-line description, product count). Product counts
  come from the real collection object, not hardcoded copy.
{%- endcomment -%}

<div
  class="pc-category-tiles section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="pc-category-tiles__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="pc-category-tiles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.all_link != blank and section.settings.all_link_text != blank -%}
      <a href="{{ section.settings.all_link }}" class="pc-category-tiles__all-link">
        {{- section.settings.all_link_text | escape -}}
      </a>
    {%- endif -%}
  </div>

  <div class="pc-category-tiles__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'pc-category-tile' -%}
        {%- assign collection = block.settings.collection -%}
        <a
          href="{{ collection.url | default: '#' }}"
          class="pc-category-tile"
          {{ block.shopify_attributes }}
        >
          {%- assign tile_image = block.settings.image | default: collection.featured_image -%}
          <div class="pc-category-tile__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 700
                | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '350,500,700', class: 'pc-category-tile__image'
              }}
            {%- else -%}
              <span class="pc-category-tile__placeholder">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </div>
          <div class="pc-category-tile__body">
            <span class="pc-category-tile__title">{{ block.settings.title | escape }}</span>
            <span class="pc-category-tile__sub">{{ block.settings.subtext | escape }}</span>
            <span class="pc-category-tile__count">
              {%- if collection != blank -%}
                {{ collection.all_products_count }} products
              {%- else -%}
                {{ block.settings.count_fallback | escape }}
              {%- endif -%}
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "tag": "div",
  "blocks": [
    {
      "type": "pc-category-tile",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (falls back to the collection's own image if left blank)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Car & travel"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "One-line description",
          "default": "Belts, boosters, hammocks and bowls for dogs who ride shotgun."
        },
        {
          "type": "text",
          "id": "count_fallback",
          "label": "Product count (shown only if no collection is set)",
          "default": "9 products"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start where the mess is"
    },
    {
      "type": "text",
      "id": "all_link_text",
      "label": "\"View all\" link text",
      "default": "All products →"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "\"View all\" link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "category": "Pawfectionco",
      "blocks": {
        "cat-1": {
          "type": "pc-category-tile",
          "settings": {
            "title": "Car & travel",
            "subtext": "Belts, boosters, hammocks and bowls for dogs who ride shotgun.",
            "count_fallback": "9 products"
          }
        },
        "cat-2": {
          "type": "pc-category-tile",
          "settings": {
            "title": "Bath & groom",
            "subtext": "Shower heads, brushes and towels that make bath night shorter.",
            "count_fallback": "11 products"
          }
        },
        "cat-3": {
          "type": "pc-category-tile",
          "settings": {
            "title": "Play",
            "subtext": "Chew toys and puzzles tested against actual destroyers.",
            "count_fallback": "8 products"
          }
        }
      },
      "block_order": ["cat-1", "cat-2", "cat-3"]
    }
  ]
}
{% endschema %}

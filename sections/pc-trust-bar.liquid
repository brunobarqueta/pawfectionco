{%- comment -%}
  Pawfectionco trust strip: a row of merchant-editable "60-night / home
  trial" style two-line stats on a sunken card. Matches the Homepage.dc.html
  mockup's trust strip exactly (no icons — just bold headline + muted sub).
{%- endcomment -%}

<div
  class="pc-trust-bar section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="pc-trust-bar__card">
    {%- for block in section.blocks -%}
      {%- if block.type == 'pc-trust-item' -%}
        <div
          class="pc-trust-bar__item"
          {{ block.shopify_attributes }}
        >
          <span class="pc-trust-bar__head">{{ block.settings.head | escape }}</span>
          <span class="pc-trust-bar__sub">{{ block.settings.sub | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "tag": "div",
  "blocks": [
    {
      "type": "pc-trust-item",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "head",
          "label": "Headline",
          "default": "60-night"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtext",
          "default": "home trial"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "category": "Pawfectionco",
      "blocks": {
        "item-1": {
          "type": "pc-trust-item",
          "settings": { "head": "60-night", "sub": "home trial" }
        },
        "item-2": {
          "type": "pc-trust-item",
          "settings": { "head": "Free returns", "sub": "no questions" }
        },
        "item-3": {
          "type": "pc-trust-item",
          "settings": { "head": "2-year", "sub": "hardware warranty" }
        },
        "item-4": {
          "type": "pc-trust-item",
          "settings": { "head": "Ships today", "sub": "order by 2pm" }
        }
      },
      "block_order": ["item-1", "item-2", "item-3", "item-4"]
    }
  ]
}
{% endschema %}

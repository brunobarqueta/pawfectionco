{%- comment -%}
  Pawfectionco trust strip: a row of merchant-editable two-line stats
  (e.g. "Free shipping / on orders $75+") on a sunken card. Matches the
  Homepage.dc.html mockup's trust strip layout (no icons — bold headline +
  muted sub). Content is real/honest claims only — no warranty or trial
  period, since this merchant doesn't offer either.
{%- endcomment -%}

<div
  class="pc-trust-bar section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="pc-trust-bar__card">
    {%- for block in section.blocks -%}
      {%- if block.type == 'pc-trust-item' -%}
        <div
          class="pc-trust-bar__item"
          {{ block.shopify_attributes }}
        >
          <span class="pc-trust-bar__head">{{ block.settings.head | escape }}</span>
          <span class="pc-trust-bar__sub">{{ block.settings.sub | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "tag": "div",
  "blocks": [
    {
      "type": "pc-trust-item",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "head",
          "label": "Headline",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtext",
          "default": "on orders $75+"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "category": "Pawfectionco",
      "blocks": {
        "item-1": {
          "type": "pc-trust-item",
          "settings": { "head": "Free shipping", "sub": "on orders $75+" }
        },
        "item-2": {
          "type": "pc-trust-item",
          "settings": { "head": "Free returns", "sub": "within 30 days" }
        },
        "item-3": {
          "type": "pc-trust-item",
          "settings": { "head": "Secure checkout", "sub": "SSL encrypted" }
        },
        "item-4": {
          "type": "pc-trust-item",
          "settings": { "head": "Fast dispatch", "sub": "ships in 1 business day" }
        }
      },
      "block_order": ["item-1", "item-2", "item-3", "item-4"]
    }
  ]
}
{% endschema %}

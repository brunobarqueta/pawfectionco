{%- doc -%}
  Pawfectionco free-shipping progress bar for the cart drawer. Real, live
  data — cart.total_price vs settings.cart_free_shipping_threshold — not
  hardcoded. Renders nothing if the merchant sets the threshold to 0 or the
  cart is empty (the empty state has its own layout).
{%- enddoc -%}

{%- liquid
  assign threshold_dollars = settings.cart_free_shipping_threshold
  assign threshold_cents = threshold_dollars | times: 100
-%}

{%- if threshold_dollars > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign remaining_cents = threshold_cents | minus: cart.total_price
    if remaining_cents < 0
      assign remaining_cents = 0
    endif
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
    assign unlocked = false
    if remaining_cents == 0
      assign unlocked = true
    endif
  -%}
  <div class="pc-cart-progress{% if unlocked %} pc-cart-progress--unlocked{% endif %}">
    <div class="pc-cart-progress__row">
      <span class="pc-cart-progress__label">
        {%- if unlocked -%}
          Free delivery unlocked
        {%- else -%}
          {{ remaining_cents | money }} away from free delivery
        {%- endif -%}
      </span>
      <span class="pc-cart-progress__tag">
        {%- if unlocked -%}
          &#10003;
        {%- else -%}
          Spend {{ threshold_cents | money_without_trailing_zeros }}
        {%- endif -%}
      </span>
    </div>
    <div class="pc-cart-progress__track">
      <div class="pc-cart-progress__fill" style="width: {{ pct }}%;"></div>
    </div>
  </div>
{%- endif -%}
